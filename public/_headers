# Hosting-level security headers (Netlify / Cloudflare Pages format).
# The CSP mirrors the <meta> injected into the built index.html by
# vite.config.ts (`CSP`). A real response header is the authoritative
# mechanism: it can express `frame-ancestors`, which browsers ignore in a
# <meta> tag. Keep both in sync.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' https://huggingface.co https://*.huggingface.co
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  # COOP + COEP together set `crossOriginIsolated`, which unlocks
  # SharedArrayBuffer and lets onnxruntime-web run the embedder on multiple
  # WASM threads — the largest lever on indexing time. `require-corp` means
  # cross-origin subresources need CORP or CORS; the only one is the Hugging
  # Face model weights, which transformers.js fetches with CORS. These are HTTP
  # headers, not CSP, so they cannot live in the <meta> tag — see vite.config.ts
  # for the dev/preview mirror.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
